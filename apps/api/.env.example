DATABASE_URL=postgresql://jplearn:jplearn@localhost:5432/jplearn
JWT_SECRET=dev-only-change-me
# Optional; falls back to JWT_SECRET. HMAC for <video src> query (exp+sig).
MEDIA_SIGNING_SECRET=dev-only-change-me
API_PUBLIC_URL=http://localhost:3001
# Optional; default OFF. POST JSON khi API trả 5xx (NFR-OBS-001).
# Payload có "text" — tương thích Slack incoming webhook. Ops cấp URL cho staging.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
