ENVIRONMENT=local
DATABASE_URL=postgresql://jplearn:jplearn@localhost:5432/jplearn
# Local example only. Replace both secrets before any shared deployment.
JWT_SECRET=local-only-change-me-at-least-32-bytes
# Local/test may fall back to JWT_SECRET; staging/production require a distinct secret.
MEDIA_SIGNING_SECRET=local-only-media-change-me-at-least-32-bytes
API_PUBLIC_URL=http://localhost:3002
# Optional; default <cwd>/storage.
# STORAGE_ROOT=/var/jplearn/storage
# Optional; default OFF. POST JSON khi API trả 5xx (NFR-OBS-001).
# Payload có "text" — tương thích Slack incoming webhook. Ops cấp URL cho staging.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional; default OFF. Bật /docs + /openapi.json (ADR-003 D8) — chỉ dùng khi debug.
# OPENAPI_UI=true
# Staging/production require explicit HTTPS origins (JSON array) and API_PUBLIC_URL.
# CORS_ORIGINS=["https://web.example.invalid"]
# Seed admin credentials must be exported in the process running seed, not only set here.
# No default admin password is created. See docs/backend/development.md.
